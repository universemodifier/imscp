#!/bin/sh
CONFFILE={PHP_FPM_CONF_FILE_PATH}
[ -r /etc/default/{PHP_FPM_BINARY} ] && . /etc/default/{PHP_FPM_BINARY}
CONF_PIDFILE=$(sed -n 's/^[[:space:]]*pid[[:space:]]*=[[:space:]]*//p' $CONFFILE)
PIDFILE=${CONF_PIDFILE:-{PHP_FPM_RUN_DIR}/{PHP_FPM_PID_FILE}}
[ -r "$PIDFILE" ] && kill -USR1 $(cat "$PIDFILE") > /dev/null
exit 0
