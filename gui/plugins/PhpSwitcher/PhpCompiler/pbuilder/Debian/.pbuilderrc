DISTRIBUTION="$DIST"
APTCACHE="/var/cache/pbuilder/psw-aptcache-$(echo "$DISTRIBUTOR_ID" | awk '{print tolower($0)}')-$DISTRIBUTION"
APTCACHEHARDLINK=yes
DEBOOTSTRAPOPTS=("${DEBOOTSTRAPOPTS[@]}" "--variant=minbase")
EXTRAPACKAGES="apt-transport-https apt-utils ca-certificates devscripts eatmydata equivs gnupg2 quilt wget"
EATMYDATA=yes
MIRRORSITE="http://deb.debian.org/debian"
COMPONENTS=main
OTHERMIRROR="deb $MIRRORSITE-security $DISTRIBUTION/updates $COMPONENTS|deb $MIRRORSITE $DISTRIBUTION-updates $COMPONENTS"
