# Setup Ondřej Surý APT repository before logging into chroot via login/execute

case $DISTRIBUTION in
  ascii)
    REAL_DISTRIBUTION=stretch
    ;;
  beowulf)
    REAL_DISTRIBUTION=buster
    ;;
  chimaera)
    REAL_DISTRIBUTION=bullseye
    ;;
  *)
    REAL_DISTRIBUTION=$DISTRIBUTION
    ;;
esac

# Add Ondřej Surý PHP repository in the /etc/apt/sources.list
/bin/cat >> "/etc/apt/sources.list" <<EOF
deb https://packages.sury.org/php/ $REAL_DISTRIBUTION main
EOF

# Download APT KEY for Ondřej Surý PHP repository
/usr/bin/wget --quiet --prefer-family=IPv4 --timeout=30 -O /tmp/ondrej-apt-key \
  https://packages.sury.org/php/apt.gpg

# Add APT KEY for Ondřej Surý PHP repository
/usr/bin/apt-key add /tmp/ondrej-apt-key

# Remove temporary file for APT KEY for Ondřej Surý PHP repository
/bin/rm -f /tmp/ondrej-apt-key

# Update APT indexes and make sure the system is up-to-date
/usr/bin/apt-get update
/usr/bin/apt-get -y --auto-remove --no-install-recommends dist-upgrade
