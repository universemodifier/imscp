# Install the PHP build dependencies before logging in to chroot via
# login/execute

tmpdir=$(/bin/mktemp --tmpdir --directory .psw-tmpdir-XXXXXX)

trap '/bin/rm -Rf -- "$tmpdir"' EXIT

cd "$tmpdir" || exit

sed 's/{PHP_VERSION}/'"$PHP_VERSION"'/' \
  "$PSW_COMPILER_ROOT_DIR/dependencies/build/$DISTRIBUTION/control" > ./control

# Build package for installation of PHP build dependencies, and install it.
/usr/bin/mk-build-deps \
  --install \
  --remove \
  --tool "apt-get -y --auto-remove --no-install-recommends -o Debug::pkgProblemResolver=yes" \
  ./control
