<link href="/LetsEncrypt/themes/default/assets/css/letsencrypt.css" rel="stylesheet">
<script>
    $(function () {
        var postURL = '/admin/letsencrypt';
        var forbiddenRedirectURL = '/index.php';

        $("#ssl_datatable").dataTable({
            language: <?= getDataTablesPluginTranslations(); ?>,
            displayLength: 10,
            stateSave: true,
            pagingType: "simple"
        }).on("click", "button", function () {
            var $button = $(this);
            var action = $(this).data("action") || "unknown";
            var $form = $(this).closest("form");
            $button.blur();

            if (action === "settings") {
                if ($button.data('dialog')) {
                    $button.data('dialog').dialog('open');
                } else {
                    var $certActionButton = $form.find('button:first');
                    var dnsNamesEditMode = $certActionButton.data("action") !== 'toadd' || parseInt($certActionButton.data("error"));
                    var buttons = [{
                        text: dnsNamesEditMode ? "<?= tojs(tr('Cancel')); ?>" : "<?= tojs(tr('Ok')); ?>",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }];

                    if (dnsNamesEditMode) {
                        buttons.unshift({
                            text: "<?= tojs(tr('Apply changes')); ?>",
                            style: "display:none",
                            class: "apply_changes_button",
                            click: function () {
                                $(this).off("dialogclose").dialog("close");
                                $certActionButton.data('confirm', '').trigger("click");
                            }
                        });
                    }

                    $button.data('dialog', $form.find(".settings_dialog").dialog({
                        hide: "blind",
                        show: "slide",
                        focus: false,
                        autoOpen: true,
                        width: 750,
                        height: 450,
                        modal: true,
                        title: "<?= tojs(tr('DNS names')); ?>",
                        buttons: buttons,
                        create: function () {
                            if (!dnsNamesEditMode) return;
                            initDialogForDNSnamesEdit($(this));
                        },
                        open: function () {
                            $(window).on("resize scroll", {dialog: $(this) }, function (e) {
                                e.data.dialog.dialog("option", "position", {my: "center", at: "center", of: window});
                            });
                        },
                        close: function (e) {
                            e.preventDefault();
                            $(window).off("resize scroll");
                        }
                    }));
                }

                return;
            }

            var $buttons = $button.closest("td").find("button");
            if ($(this).data("confirm")) {
                confirm($(this).data("confirm"), function (ret) {
                    if (!ret) return;
                    $buttons.prop("disabled", true).button("refresh");
                    handleResponse(doRequest($form, action, postURL), postURL, forbiddenRedirectURL).fail(function() {
                        $buttons.prop("disabled", false).button("refresh");
                    });

                });
            } else {
                $buttons.prop("disabled", true).button("refresh");
                handleResponse(doRequest($form, action, postURL), postURL, forbiddenRedirectURL).fail(function() {
                    $buttons.prop("disabled", false).button("refresh");
                });
            }
        });
    });
</script>
