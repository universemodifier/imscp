#!/bin/sh
PERCENT=$1
USER=$2
# Dovecot 2.3 accepts a plugin override so the warning itself is not rejected.
# Dovecot 2.4 removed that plugin setting.
if /usr/sbin/dovecot --version 2>/dev/null | grep -q '^2\.3'; then
    set -- -d "$USER" -o "plugin/quota=maildir:User quota:noenforcing"
else
    set -- -d "$USER"
fi
cat << EOF | {DOVECOT_DELIVER_PATH} "$@"
From: postmaster@{HOSTNAME}
Subject: i-MSCP Quota Warning

You are using ${PERCENT}% of the space assigned to your mailbox.
EOF
